# Exemple de variables d'environnement pour le projet
# --- Variables publiques (client) ---
# Ces variables peuvent être exposées côté client (EXPO_PUBLIC_*)
EXPO_PUBLIC_SUPABASE_URL=https://your.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Variables serveur / secrets (à définir uniquement dans CI / secrets manager) ---
# Ne jamais committer ces valeurs dans le dépôt
SUPABASE_URL=https://your.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Autres variables utiles pour CI / builds ---
# EAS project id (optionnel)
EAS_PROJECT_ID=your-eas-project-id
# Chemin local vers google-services.json (debug local uniquement)
GOOGLE_SERVICES_JSON_PATH=path/to/google-services.json
# Keystore Android (stockez les valeurs réelles dans CI secrets)
ANDROID_KEYSTORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=your-key-alias
ANDROID_KEY_PASSWORD=your-key-password

# Pour valider localement: copiez ce fichier en ".env" et remplissez les valeurs non-sensibles.
# En CI, définissez les variables listées ci-dessus dans le gestionnaire de secrets (GitHub/GitLab/Bitrise/EAS secrets).
